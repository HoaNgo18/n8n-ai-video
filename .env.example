# Threads mining and screenshot login
THREADS_USERNAME=your_threads_username
THREADS_PASSWORD=your_threads_password
THREADS_STORAGE_STATE=runtime/storage/threads-state.json
THREADS_DEBUG_DIR=runtime/debug
THREADS_FORCE_LOGIN=false
THREADS_TIMEOUT_MS=30000
THREADS_POST_LOGIN_WAIT_MS=5000

# Phase 1 candidate filtering
MAX_POSTS=15
SCROLL_COUNT=20
CANDIDATE_LIMIT=75
MIN_ENGAGEMENT_SCORE=1000
MIN_STRONGEST_METRIC_SCORE=1000
MIN_CONTENT_FIT_SCORE=2
THREADS_CLASSIFIER_ENABLED=true
THREADS_CLASSIFIER_MODEL=gemini-2.5-flash-lite
THREADS_PRIORITY_TOPICS=
THREADS_TREND_BRIEF=

# Phase 1 trend/search signals. RSS sources are public and do not require API keys.
TREND_SIGNAL_ENABLED=true
TREND_RSS_URLS=
TREND_TOPICS_LIMIT=10
TREND_CONTEXT_LIMIT=8
TREND_FETCH_TIMEOUT_SECONDS=12
TREND_RUN_TIMEOUT_SECONDS=60
THREADS_SEARCH_MAX_POSTS=10
THREADS_MINER_TIMEOUT_SECONDS=420
THREADS_SEARCH_TIMEOUT_SECONDS=240
THREADS_TREND_KEYWORDS_LIMIT=4
THREADS_SWEEP_SCROLL_COUNT=4
THREADS_SWEEP_QUERIES=

# Runtime output folders
SCREENSHOTS_DIR=runtime/data/screenshots
AUDIO_DIR=runtime/data/audio
VISUALS_DIR=runtime/data/visuals
VIDEOS_DIR=runtime/data/videos
TEMP_DIR=runtime/data/temp
EXPORTS_DIR=runtime/data/exports

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_FILE=/workspace/google-service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Threads

# Telegram bots
# Phase 4 review/publish bot. The double underscore is intentional to match
# the existing local .env naming.
TELEGRAM__PHASE4_BOT_TOKEN=
TELEGRAM_PHASE1_BOT_TOKEN=
TELEGRAM_CHAT_ID=
N8N_PHASE1_SEARCH_CALLBACK_URL=http://n8n:5678/webhook/phase1-search-callback
N8N_PHASE2_START_URL=http://n8n:5678/webhook/phase2-start
N8N_PHASE3_START_URL=http://n8n:5678/webhook/phase3-start
N8N_PHASE4_START_URL=http://n8n:5678/webhook/phase4-start

# Local review server. Set REVIEW_PUBLIC_BASE_URL to your ngrok/cloudflared
# tunnel for the runner, for example: https://abc123.ngrok-free.app
REVIEW_PUBLIC_BASE_URL=http://localhost:8000
REVIEW_TOKEN_SECRET=change-this-to-a-long-random-secret
N8N_PHASE4_CALLBACK_URL=http://n8n:5678/webhook/phase4-review-callback

# Screenshot capture
THREADS_SCREENSHOT_THEME=dark
THREADS_SCREENSHOT_DPR=2

# Background video selection
# Fixed file mode:
#   set BACKGROUND_VIDEO_PATH to a real file and leave BACKGROUND_VIDEO_DIR empty.
# Folder mode:
#   set BACKGROUND_VIDEO_DIR and choose BACKGROUND_VIDEO_PICK=hash/random/first.
BACKGROUND_VIDEO_PATH=runtime/assets/background.mp4
BACKGROUND_VIDEO_DIR=runtime/assets/backgrounds
BACKGROUND_VIDEO_PICK=hash

# Background music mixed under narration in Phase 3C.
BACKGROUND_MUSIC_ENABLED=false
BACKGROUND_MUSIC_DIR=runtime/assets/music/lofi
BACKGROUND_MUSIC_PATH=
BACKGROUND_MUSIC_PICK=hash
BACKGROUND_MUSIC_VOLUME=0.08
BACKGROUND_MUSIC_FADE_SECONDS=1.5
BACKGROUND_MUSIC_START_OFFSET_SECONDS=0
BACKGROUND_MUSIC_DUCKING=true

# Manual upload helper
MANUAL_UPLOAD_COPY_VIDEO=false

# Visual layout and sync
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VISUAL_TIMING_LEAD_SECONDS=0.0
OVERLAY_WIDTH_RATIO=0.98
OVERLAY_TOP_RATIO=0.24
OVERLAY_CORNER_RADIUS_RATIO=0.035
OVERLAY_SHADOW_OPACITY=105
OVERLAY_ANIMATION=fade_slide
OVERLAY_ANIMATION_SECONDS=0.35
OVERLAY_SLIDE_PIXELS=56

# Video/audio encode quality
VIDEO_ENCODE_PRESET=medium
VIDEO_CRF=16
VIDEO_TARGET_BITRATE=14M
VIDEO_MAXRATE=18M
VIDEO_BUFSIZE=36M
AUDIO_BITRATE=192k

# Narration segmentation
AUDIO_SEGMENT_SOURCE=extracted
AUDIO_TRIM_SEGMENT_SILENCE=false
AUDIO_SILENCE_THRESHOLD_DB=-45dB
AUDIO_LEADING_SILENCE_SECONDS=0.08
AUDIO_TRAILING_SILENCE_SECONDS=0.18
AUDIO_SEGMENT_OVERLAP_SECONDS=0.15
AUDIO_MAX_SEGMENTS=7
AUDIO_MAX_POST_CHARS=220
AUDIO_MAX_COMMENT_CHARS=260

# Text to speech
# VieNeu is the only supported TTS engine in this project.
TTS_ENGINE_ORDER=vieneu
TTS_VOICE=
# Optional per-author voices. Each unique author_key is assigned the next
# voice in this list and then reused consistently for later segments.
# For VieNeu, use preset:<voice_id> or ref:<path_to_audio_sample>.
TTS_AUTHOR_VOICES=
TTS_DISCUSSION_VOICES=

# VieNeu TTS
VIENEU_TTS_ENABLED=true
VIENEU_MODE=v3turbo
VIENEU_BACKBONE_REPO=
VIENEU_BACKBONE_DEVICE=
VIENEU_CODEC_REPO=
VIENEU_CODEC_DEVICE=
VIENEU_VOICE_REF=
VIENEU_VOICE_REF_TEXT=
# Examples:
# TTS_AUTHOR_VOICES=preset:voice_1,preset:voice_2,preset:voice_3,preset:voice_4
# TTS_AUTHOR_VOICES=ref:runtime/assets/voices/a.wav,ref:runtime/assets/voices/b.wav

# Docker runner stores model/cache paths on the mounted model-cache volume.
HF_HOME=/models/huggingface
HUGGINGFACE_HUB_CACHE=/models/huggingface/hub

# Gemini / AI nodes
GEMINI_API_KEY=
SCRIPT_REWRITE_ENABLED=false
SCRIPT_REWRITE_API_KEY=
SCRIPT_REWRITE_MODEL=gemini-2.5-flash
SCRIPT_REWRITE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
SCRIPT_REWRITE_TIMEOUT_MS=45000
AI_CAPTION_ENABLED=true
AI_CAPTION_MODEL=gemini-2.5-flash-lite

# TikTok publishing
# Phase 4 is semi-automated when using Playwright/browser upload because TikTok
# can interrupt with captcha, checkpoints, or expired sessions.
TIKTOK_PUBLISHER_MODE=playwright
TIKTOK_DRY_RUN=true
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
TIKTOK_DISABLE_DUET=false
TIKTOK_DISABLE_COMMENT=false
TIKTOK_DISABLE_STITCH=false
TIKTOK_BRAND_CONTENT=false
TIKTOK_BRAND_ORGANIC=false
TIKTOK_IS_AIGC=false
TIKTOK_COVER_TIMESTAMP_MS=1000
TIKTOK_COVER_DIR=runtime/data/temp/tiktok_covers
TIKTOK_UPLOAD_BROWSER=chromium
TIKTOK_UPLOAD_HEADLESS=true
TIKTOK_UPLOAD_RETRIES=1
TIKTOK_SKIP_SPLIT_WINDOW=false

# TikTok browser uploader auth
TIKTOK_SESSION_ID=
TIKTOK_USERNAME=
TIKTOK_PASSWORD=
TIKTOK_UPLOADER_COOKIES_PATH=tiktok_cookies.json

# TikTok Content Posting API path. Usually unused unless OAuth/app setup is ready.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_TOKEN_SCOPE=
TIKTOK_ACCESS_TOKEN_EXPIRES_AT=
TIKTOK_REFRESH_TOKEN_EXPIRES_AT=
TIKTOK_CHUNK_SIZE=67108864
