                      "name":  "Merge Classifier Result"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "function cleanText(value) {\n  return String(value || \u0027\u0027).replace(/\\s+/g, \u0027 \u0027).trim();\n}\n\nfunction parseJsonCandidate(text) {\n  const cleaned = cleanText(text);\n  if (!cleaned) return null;\n\n  const fencedMatch = cleaned.match(/```(?:json)?\\s*([\\s\\S]*?)```/i);\n  const jsonSource = fencedMatch ? fencedMatch[1] : cleaned;\n  const braceMatch = jsonSource.match(/\\{[\\s\\S]*\\}/);\n  const candidate = braceMatch ? braceMatch[0] : jsonSource;\n\n  try {\n    const parsed = JSON.parse(candidate);\n    return parsed \u0026\u0026 typeof parsed === \u0027object\u0027 ? parsed : null;\n  } catch (error) {\n    return null;\n  }\n}\n\nfunction extractTextDeep(value, bucket = []) {\n  if (typeof value === \u0027string\u0027) {\n    const cleaned = cleanText(value);\n    if (cleaned) bucket.push(cleaned);\n    return bucket;\n  }\n\n  if (!value || typeof value !== \u0027object\u0027) return bucket;\n  if (Array.isArray(value)) {\n    value.forEach(entry =\u003e extractTextDeep(entry, bucket));\n    return bucket;\n  }\n\n  Object.values(value).forEach(entry =\u003e {\n    if (typeof entry === \u0027string\u0027) {\n      const cleaned = cleanText(entry);\n      if (cleaned) bucket.push(cleaned);\n    } else if (entry \u0026\u0026 typeof entry === \u0027object\u0027) {\n      extractTextDeep(entry, bucket);\n    }\n  });\n  return bucket;\n}\n\nfunction extractClassifierDecision(data) {\n  if (!data || typeof data !== \u0027object\u0027) return null;\n\n  const direct = [data.output, data.text, data.content, data.message, data.response].filter(Boolean);\n  for (const candidate of direct) {\n    const parsed = parseJsonCandidate(candidate);\n    if (parsed) return parsed;\n  }\n\n  for (const candidate of extractTextDeep(data, [])) {\n    const parsed = parseJsonCandidate(candidate);\n    if (parsed) return parsed;\n  }\n\n  return null;\n}\n\nconst kept = [];\n\nfor (const item of $input.all()) {\n  const classifier = item.json._classifier || {};\n  const preview = cleanText(classifier.preview || item.json.text_preview || \u0027\u0027);\n  const fitScore = Number(classifier.fitScore || item.json.content_fit_score || 0);\n  const fitTags = Array.isArray(classifier.fitTags || item.json.content_fit_tags) ? (classifier.fitTags || item.json.content_fit_tags) : [];\n  const strongestMetric = Number(classifier.strongestMetric || item.json.engagement_strongest_metric || 0);\n  const metricCount = Number(classifier.metricCount || item.json.engagement_metric_count || 0);\n  const classifierEnabled = classifier.enabled !== false;\n  const fallbackKeep = fitScore \u003e= 5 \u0026\u0026 preview.length \u003e= 140 \u0026\u0026 metricCount \u003e= 2 \u0026\u0026 strongestMetric \u003e= 1000 \u0026\u0026 (fitTags.includes(\u0027discussion\u0027) || fitTags.includes(\u0027story\u0027) || fitTags.includes(\u0027topic-hot\u0027) || fitTags.includes(\u0027priority-topic\u0027) || fitTags.includes(\u0027mass-appeal\u0027));\n  const parsed = classifierEnabled ? extractClassifierDecision(item.json) : null;\n\n  let decision = fallbackKeep ? \u0027keep\u0027 : \u0027reject\u0027;\n  let angle = fitTags.includes(\u0027discussion\u0027) ? \u0027discussion\u0027 : (fitTags.includes(\u0027story\u0027) ? \u0027story_hot\u0027 : ((fitTags.includes(\u0027topic-hot\u0027) || fitTags.includes(\u0027priority-topic\u0027) || fitTags.includes(\u0027mass-appeal\u0027)) ? \u0027topic_hot\u0027 : \u0027reject\u0027));\n  let confidence = fallbackKeep ? 0.6 : 0.35;\n  let reason = fallbackKeep\n    ? `heuristic keep fit=${fitScore} metricCount=${metricCount} strongest=${strongestMetric} tags=${fitTags.join(\u0027,\u0027) || \u0027none\u0027}`\n    : `heuristic reject fit=${fitScore} metricCount=${metricCount} strongest=${strongestMetric} preview_too_weak`;\n\n  if (strongestMetric \u003c 1000) {\n    decision = \u0027reject\u0027;\n    angle = \u0027reject\u0027;\n    confidence = Math.max(confidence, 0.7);\n    reason = `reject strongest_metric_under_1000 strongest=${strongestMetric} total=${classifier.engagementScore || item.json.engagement_score || 0}`;\n  } else if (!classifierEnabled) {\n    reason = `ai disabled; ${reason}`;\n  } else if (parsed) {\n    const parsedDecision = cleanText(parsed.decision || \u0027\u0027).toLowerCase();\n    const parsedAngle = cleanText(parsed.angle || \u0027\u0027).toLowerCase();\n    const parsedReason = cleanText(parsed.reason || \u0027\u0027);\n    const parsedConfidence = Number(parsed.confidence || 0);\n    if ((parsedDecision === \u0027keep\u0027 || parsedDecision === \u0027reject\u0027) \u0026\u0026 [\u0027discussion\u0027, \u0027story_hot\u0027, \u0027topic_hot\u0027, \u0027reject\u0027].includes(parsedAngle || \u0027reject\u0027)) {\n      decision = parsedDecision;\n      angle = parsedAngle || (parsedDecision === \u0027keep\u0027 ? \u0027discussion\u0027 : \u0027reject\u0027);\n      confidence = Number.isFinite(parsedConfidence) ? parsedConfidence : confidence;\n      reason = parsedReason || reason;\n    }\n  } else {\n    reason = `ai fallback; ${reason}`;\n  }\n\n  item.json._classifier_decision = decision;\n  item.json._classifier_angle = angle;\n  item.json._classifier_confidence = Math.max(0, Math.min(1, confidence || 0));\n  item.json._classifier_reason = reason;\n\n  if (decision === \u0027keep\u0027 \u0026\u0026 [\u0027discussion\u0027, \u0027story_hot\u0027, \u0027topic_hot\u0027].includes(angle)) {\n    kept.push(item);\n  }\n}\n\nreturn kept;"
                                     },
