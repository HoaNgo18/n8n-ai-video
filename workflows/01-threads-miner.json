                  {
                      "parameters":  {
                                         "jsCode":  "const payload = $input.first().json;\nconst posts = Array.isArray(payload.posts) ? payload.posts : [];\nif (!Array.isArray(posts)) {\n  throw new Error(\u0027Threads miner must return posts as a JSON array.\u0027);\n}\n\nreturn posts\n  .filter(p =\u003e p \u0026\u0026 p.id \u0026\u0026 p.url)\n  .map(p =\u003e ({ json: p }));"
