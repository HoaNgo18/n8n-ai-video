    {
      "parameters": {
        "jsCode": "const { spawn } = require('child_process');\n\nconst python = 'D:\\\\Project III\\\\n8n-ai-video\\\\venv\\\\Scripts\\\\python.exe';\nconst script = 'D:\\\\Project III\\\\n8n-ai-video\\\\src\\\\threads_miner.py';\n\nfunction runPython(args, timeoutMs) {\n  return new Promise((resolve, reject) => {\n    const child = spawn(python, args, {\n      cwd: 'D:\\\\Project III\\\\n8n-ai-video',\n      windowsHide: true,\n    });\n\n    let stdout = '';\n    let stderr = '';\n\n    const timer = setTimeout(() => {\n      child.kill();\n      reject(new Error(`Threads miner timed out after ${timeoutMs}ms`));\n    }, timeoutMs);\n\n    child.stdout.on('data', data => {\n      stdout += data.toString('utf8');\n    });\n\n    child.stderr.on('data', data => {\n      stderr += data.toString('utf8');\n    });\n\n    child.on('error', error => {\n      clearTimeout(timer);\n      reject(error);\n    });\n\n    child.on('close', code => {\n      clearTimeout(timer);\n      resolve({ code, stdout, stderr });\n    });\n  });\n}\n\nconst result = await runPython([script], 180000);\n\nif (result.code !== 0) {\n  throw new Error(`Threads miner failed with exit ${result.code}. stderr: ${(result.stderr || '').slice(0, 4000)}`);\n}\n\nreturn [{ json: { stdout: result.stdout || '', stderr: result.stderr || '' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1936,
        1008
      ],
      "id": "af40cc8d-a985-4c44-beb9-aded0e34b4ea",
      "name": "Run Threads Miner"
    },
    {
      "parameters": {
        "jsCode": "const stdout = ($input.first().json.stdout || '').trim();\nif (!stdout) return [];\n\nlet posts;\ntry {\n  posts = JSON.parse(stdout);\n} catch (e) {\n  throw new Error('Could not parse Threads miner JSON. stdout starts with: ' + stdout.substring(0, 300));\n}\n\nif (!Array.isArray(posts)) {\n  throw new Error('Threads miner must return a JSON array.');\n}\n\nreturn posts\n  .filter(p => p && p.id && p.url)\n  .map(p => ({ json: p }));"
      },
