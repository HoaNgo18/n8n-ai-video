                      "id":  "daa3c9f4-f436-411e-b2aa-b081cb35f1c0",
                      "name":  "Parse JSON Output"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "function cleanText(value) {\n  return String(value || \u0027\u0027).replace(/\\s+/g, \u0027 \u0027).trim();\n}\n\nconst env = (typeof process !== \u0027undefined\u0027 \u0026\u0026 process.env) ? process.env : {};\nconst enabled = [\u00271\u0027, \u0027true\u0027, \u0027yes\u0027].includes(String(env.THREADS_CLASSIFIER_ENABLED || \u0027true\u0027).trim().toLowerCase());\nconst model = String(env.THREADS_CLASSIFIER_MODEL || \u0027gemini-2.5-flash-lite\u0027).trim();\nconst trendBrief = cleanText(env.THREADS_TREND_BRIEF || \u0027\u0027);\nconst priorityTopics = cleanText(env.THREADS_PRIORITY_TOPICS || \u0027\u0027);\n\nreturn $input.all().map(item =\u003e {\n  const preview = cleanText(item.json.text_preview || \u0027\u0027);\n  const fitScore = Number(item.json.content_fit_score || 0);\n  const fitTags = Array.isArray(item.json.content_fit_tags) ? item.json.content_fit_tags : [];\n  const engagementScore = Number(item.json.engagement_score || 0);\n  const engagementMetrics = Array.isArray(item.json.engagement_metrics) ? item.json.engagement_metrics : [];\n  const strongestMetric = Number(item.json.engagement_strongest_metric || 0);\n  const metricCount = Number(item.json.engagement_metric_count || 0);\n\n  item.json._classifier = {\n    enabled,\n    model,\n    preview,\n    fitScore,\n    fitTags,\n    engagementScore,\n    engagementMetrics,\n    strongestMetric,\n    metricCount,\n    trendBrief,\n    priorityTopics,\n    prompt: [\n      \u0027Ban la bo loc noi dung cho kenh video ngan tieng Viet.\u0027,\n      \u0027Hay danh gia preview cua mot bai Threads xem co nen dua vao pipeline lam video binh luan/storytime dang hot khong.\u0027,\n      \u0027CHI GIU bai co it nhat mot trong cac diem manh: tranh luan ro, cau hoi mo de nguoi xem binh luan, xung dot/plot twist, van de xa hoi dang nong, hoac bai hoc/kinh nghiem co tinh bat ngo va khong bi self-promo.\u0027,\n      \u0027discussion phai co y kien trai chieu hoac cau hoi that su dang ban. story_hot phai co dien bien gay to mo, drama, plot twist, rui ro, sai lam, ket qua bat ngo, hoac bai hoc khien nguoi xem muon nghe tiep. topic_hot phai la van de cong chung co kha nang gay tranh luan.\u0027,\n      trendBrief ? \u0027CURRENT_TREND_BRIEF: \u0027 + trendBrief : \u0027CURRENT_TREND_BRIEF: none\u0027,\n      priorityTopics ? \u0027PRIORITY_TOPICS: \u0027 + priorityTopics : \u0027PRIORITY_TOPICS: none\u0027,\n      \u0027Uu tien bai co mass appeal: anh huong tien bac, nha cua, giao thong, cong viec, gia dinh, suc khoe, giao duc, chinh sach, do thi, an toan, tam linh/kinh di, hoac van de nhieu nguoi Viet co the lien he ngay.\u0027,\n      \u0027BAT BUOC reject neu preview chi hot trong fandom/cong dong nho, drama idol/nhom nhac, cau chuyen noi bo, hoac engagement cao nhung nguoi ngoai khong co ly do quan tam.\u0027,\n      \u0027BAT BUOC reject neu preview chi la ke hanh trinh ca nhan truyen cam hung, quang ba podcast/kenh/brand, cam on/chia se chung chung, meo nghe nghiep qua hien lanh, hoac bai khong tao duoc cau hoi binh luan ro rang.\u0027,\n      \u0027BAT BUOC reject neu strongest_metric \u003c 1000 hoac engagement chu yeu la tong nhieu metric nho, tru khi noi dung cuc ky gay tranh luan/viral.\u0027,\n      \u0027Duoc phep dung fit score va engagement lam ngu canh phu, nhung quyet dinh chinh phai dua tren kha nang giu chan nguoi xem va tao binh luan.\u0027,\n      \u0027Tra ve DUY NHAT mot JSON hop le theo schema: {\"decision\":\"keep|reject\",\"angle\":\"discussion|story_hot|topic_hot|reject\",\"confidence\":0.0,\"reason\":\"...\"}.\u0027,\n      \u0027reason phai ngan gon, neu reject thi noi ro ly do chinh.\u0027,\n    ].join(\u0027 \u0027),\n  };\n\n  return item;\n});"
                                     },
