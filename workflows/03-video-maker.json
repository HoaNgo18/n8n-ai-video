    {
      "parameters": {
        "jsCode": "const rows = $input.all().filter(item => {\n  const status = String(item.json.Status || '').trim().toLowerCase();\n  const hasScreenshots = String(item.json.Screenshots || '').trim();\n  const hasAudio = String(item.json.Audio_Path || '').trim();\n  const hasVisual = String(item.json.Visual_Video_Path || '').trim();\n  return status === 'in progress' && hasScreenshots && hasAudio && !hasVisual;\n});\n\nreturn rows.slice(0, 1);"
      },
