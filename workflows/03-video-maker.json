        "jsCode": "const rows = $input.all().filter(item => {\n  const status = String(item.json.Status || '').trim().toLowerCase();\n  const audioPath = String(item.json.Audio_Path || '').trim();\n  const visualPath = String(item.json.Visual_Video_Path || '').trim();\n  const finalPath = String(item.json.Video_Path || '').trim();\n  return status === 'in progress' && audioPath && visualPath && !finalPath;\n});\n\nreturn rows.slice(0, 1);"
