    {
      "parameters": {
        "jsCode": "const rows = $input.all().filter(item => {\n  const status = String(item.json.Status || '').trim().toLowerCase();\n  const hasScript = String(item.json.Narrator_Script || '').trim();\n  const hasAudio = String(item.json.Audio_Path || '').trim();\n  return status === 'in progress' && hasScript && !hasAudio;\n});\n\nreturn rows.slice(0, 1);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        720
      ],
      "id": "fb3da1a5-d2b0-4666-8200-c9343e79df5d",
      "name": "Pick Voice Row"
    },
    {
      "parameters": {
        "jsCode": "const { spawn } = require('child_process');\n\nconst python = 'D:\\\\Project III\\\\n8n-ai-video\\\\venv\\\\Scripts\\\\python.exe';\nconst script = 'D:\\\\Project III\\\\n8n-ai-video\\\\src\\\\video_factory.py';\nconst inputItems = $input.all();\nconst output = [];\n\nfunction runPython(args, timeoutMs) {\n  return new Promise((resolve, reject) => {\n    const child = spawn(python, args, {\n      cwd: 'D:\\\\Project III\\\\n8n-ai-video',\n      windowsHide: true,\n    });\n\n    let stdout = '';\n    let stderr = '';\n    const timer = setTimeout(() => {\n      child.kill();\n      reject(new Error(`Voice generator timed out after ${timeoutMs}ms`));\n    }, timeoutMs);\n\n    child.stdout.on('data', data => { stdout += data.toString('utf8'); });\n    child.stderr.on('data', data => { stderr += data.toString('utf8'); });\n    child.on('error', error => {\n      clearTimeout(timer);\n      reject(error);\n    });\n    child.on('close', code => {\n      clearTimeout(timer);\n      resolve({ code, stdout, stderr });\n    });\n  });\n}\n\nfor (const item of inputItems) {\n  const id = String(item.json.ID || '').trim();\n  const scriptText = String(item.json.Narrator_Script || '').trim();\n  if (!id || !scriptText) continue;\n\n  const result = await runPython([script, '--mode', 'voice', '--id', id, '--script', scriptText], 240000);\n\n  if (result.code !== 0) {\n    throw new Error(`Voice generator failed for ${id} with exit ${result.code}. stderr: ${(result.stderr || '').slice(0, 4000)}`);\n  }\n\n  let parsed;\n  try {\n    parsed = JSON.parse((result.stdout || '').trim());\n  } catch (error) {\n    throw new Error(`Could not parse voice generator JSON for ${id}. stdout: ${(result.stdout || '').slice(0, 1000)}`);\n  }\n\n  output.push({ json: parsed });\n}\n\nreturn output;"
      },
