        1120
      ],
      "id": "fd680840-5622-4cb0-80d1-e7f77d5d6704",
      "name": "Pick Merge Row"
    },
    {
      "parameters": {
        "jsCode": "const { spawn } = require('child_process');\n\nconst python = 'D:\\\\Project III\\\\n8n-ai-video\\\\venv\\\\Scripts\\\\python.exe';\nconst script = 'D:\\\\Project III\\\\n8n-ai-video\\\\src\\\\video_factory.py';\nconst inputItems = $input.all();\nconst output = [];\n\nfunction runPython(args, timeoutMs) {\n  return new Promise((resolve, reject) => {\n    const child = spawn(python, args, {\n      cwd: 'D:\\\\Project III\\\\n8n-ai-video',\n      windowsHide: true,\n    });\n\n    let stdout = '';\n    let stderr = '';\n    const timer = setTimeout(() => {\n      child.kill();\n      reject(new Error(`Merge final timed out after ${timeoutMs}ms`));\n    }, timeoutMs);\n\n    child.stdout.on('data', data => { stdout += data.toString('utf8'); });\n    child.stderr.on('data', data => { stderr += data.toString('utf8'); });\n    child.on('error', error => {\n      clearTimeout(timer);\n      reject(error);\n    });\n    child.on('close', code => {\n      clearTimeout(timer);\n      resolve({ code, stdout, stderr });\n    });\n  });\n}\n\nfor (const item of inputItems) {\n  const id = String(item.json.ID || '').trim();\n  const audioPath = String(item.json.Audio_Path || '').trim();\n  const visualPath = String(item.json.Visual_Video_Path || '').trim();\n  if (!id || !audioPath || !visualPath) continue;\n\n  const result = await runPython([script, '--mode', 'merge', '--id', id, '--audio-path', audioPath, '--visual-path', visualPath], 240000);\n\n  if (result.code !== 0) {\n    throw new Error(`Merge final failed for ${id} with exit ${result.code}. stderr: ${(result.stderr || '').slice(0, 4000)}`);\n  }\n\n  let parsed;\n  try {\n    parsed = JSON.parse((result.stdout || '').trim());\n  } catch (error) {\n    throw new Error(`Could not parse merge final JSON for ${id}. stdout: ${(result.stdout || '').slice(0, 1000)}`);\n  }\n\n  output.push({ json: parsed });\n}\n\nreturn output;"
      },
