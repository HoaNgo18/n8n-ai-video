      "parameters": {
        "jsCode": "const rows = $input.all()\n  .map(item => {\n    const status = String(item.json.Status || '').trim().toLowerCase();\n    const decision = String(item.json.Admin_Decision || '').trim().toLowerCase();\n    if (status !== 'draft') return null;\n    if (!['approve', 'approved', 'reject', 'rejected'].includes(decision)) return null;\n\n    const approved = decision === 'approve' || decision === 'approved';\n    return {\n      json: {\n        ID: item.json.ID,\n        Status: approved ? 'Ready To Upload' : 'Rejected',\n        Admin_Decision: decision,\n        Note: approved\n          ? 'Phase 4: approved by admin; ready for manual TikTok upload'\n          : 'Phase 4: rejected by admin',\n      },\n    };\n  })\n  .filter(Boolean);\n\nreturn rows.slice(0, 1);"
      },
