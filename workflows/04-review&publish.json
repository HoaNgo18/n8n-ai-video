    {
      "parameters": {
        "jsCode": "const decision = $('Save Admin Decision + Ack Telegram').item.json;\nconst approvedId = String(decision.id || '').trim();\nif (!approvedId) {\n  throw new Error('Approved callback did not return a row ID');\n}\n\nfor (const item of $input.all()) {\n  const id = String(item.json.ID || '').trim();\n  const status = String(item.json.Status || '').trim().toLowerCase();\n  const videoPath = String(item.json.Video_Path || '').trim();\n  const caption = String(item.json.Caption || '').trim();\n  const publishId = String(item.json.TikTok_Publish_ID || '').trim();\n  if (id !== approvedId) continue;\n  if (status !== 'approved') continue;\n  if (!videoPath || !caption || publishId) continue;\n\n  return [{\n    json: {\n      ID: item.json.ID,\n      Video_Path: item.json.Video_Path,\n      Caption: item.json.Caption,\n    },\n  }];\n}\n\nreturn [{ json: { ID: approvedId, Status: 'Publish Failed', Note: 'Phase 4: approved row was not publishable after callback' } }];"
      },
