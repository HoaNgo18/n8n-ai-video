    {
      "parameters": {
        "jsCode": "function getTargetId() {\n  try {\n    const webhookItem = $('Phase 4 Start Webhook').first();\n    const payload = webhookItem.json.body || webhookItem.json || {};\n    return String(payload.id || '').trim();\n  } catch (error) {\n    return '';\n  }\n}\n\nconst targetId = getTargetId();\nfor (const item of $input.all()) {\n  const id = String(item.json.ID || '').trim();\n  const status = String(item.json.Status || '').trim().toLowerCase();\n  const videoPath = String(item.json.Video_Path || '').trim();\n  const caption = String(item.json.Caption || '').trim();\n  const draftUrl = String(item.json.Draft_Video_URL || '').trim();\n  const publishId = String(item.json.TikTok_Publish_ID || '').trim();\n\n  if (targetId && id !== targetId) continue;\n\n  if (status === 'draft' && videoPath && caption && !draftUrl) {\n    return [{\n      json: {\n        action: 'create_review',\n        ID: item.json.ID,\n        Video_Path: item.json.Video_Path,\n        Caption: item.json.Caption,\n      },\n    }];\n  }\n\n  if (status === 'approved' && videoPath && caption && !publishId) {\n    return [{\n      json: {\n        action: 'publish',\n        ID: item.json.ID,\n        Video_Path: item.json.Video_Path,\n        Caption: item.json.Caption,\n      },\n    }];\n  }\n}\n\nreturn [{ json: { action: 'idle', Note: 'Phase 4: no eligible row found' } }];"
      },
      "id": "3d55582d-b348-4abb-b640-919a9be652d1",
      "name": "Pick Phase 4 Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        816
      ]
    },
